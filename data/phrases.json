    { "id": "youre-handsome",   "cat": "compliments",   "en": "You look handsome today",        "zh": "你今天很帅",         "py": "nǐ jīn tiān hěn shuài",           "phon": "nee jin tyen hun SHWYE" },
    { "id": "you-look-lovely",  "cat": "compliments",   "en": "You look lovely today",          "zh": "你今天真好看",       "py": "nǐ jīn tiān zhēn hǎo kàn",        "phon": "nee jin tyen jun HOW kahn",           "note": "好看 works for anyone — the gender-neutral safe bet." },
    { "id": "nice-smile",       "cat": "compliments",   "en": "Your smile is beautiful",        "zh": "你笑起来真好看",     "py": "nǐ xiào qǐ lái zhēn hǎo kàn",     "phon": "nee shyaow chee lye jun HOW kahn" },
    { "id": "outfit-suits-you", "cat": "compliments",   "en": "That outfit really suits you",   "zh": "这件衣服很适合你",   "py": "zhè jiàn yī fu hěn shì hé nǐ",    "phon": "juh jyen ee foo hun shr huh NEE" },
    { "id": "you-smell-nice",   "cat": "compliments",   "en": "You smell nice",                 "zh": "你好香",             "py": "nǐ hǎo xiāng",                    "phon": "nee how SHYAHNG",                     "note": "A genuine, common compliment in Chinese — not weird at all." },
    { "id": "so-good-to-me",    "cat": "compliments",   "en": "You're so good to me",           "zh": "你对我真好",         "py": "nǐ duì wǒ zhēn hǎo",              "phon": "nee dway wor jun HOW" },
    { "id": "youre-amazing",    "cat": "compliments",   "en": "You're amazing",                 "zh": "你太棒了",           "py": "nǐ tài bàng le",                  "phon": "nee tye BAHNG luh" },
    { "id": "proud-of-you",     "cat": "compliments",   "en": "I'm proud of you",               "zh": "我为你骄傲",         "py": "wǒ wèi nǐ jiāo ào",               "phon": "wor way nee jyaow AOW" },
    { "id": "you-did-great",    "cat": "compliments",   "en": "You did really well",            "zh": "你做得很好",         "py": "nǐ zuò de hěn hǎo",               "phon": "nee dzwor duh hun HOW" },
    { "id": "thank-you",        "cat": "compliments",   "en": "Thank you",                      "zh": "谢谢你",             "py": "xiè xie nǐ",                      "phon": "SHYEH shyeh nee" , "starter": 4 },

    { "id": "hello-parents",    "cat": "family",        "en": "Hello (to her parents)",         "zh": "叔叔阿姨好",         "py": "shū shu ā yí hǎo",                "phon": "shoo shoo ah yee HOW",                "note": "The safe, warm way to greet her mum and dad. Don't use their names." },
    { "id": "glad-to-meet-you", "cat": "family",        "en": "So glad to meet you",            "zh": "很高兴见到您",       "py": "hěn gāo xìng jiàn dào nín",       "phon": "hun gaow shing jyen daow NEEN",       "note": "您 is the respectful \"you\" — use it with anyone older." },
    { "id": "thanks-for-having","cat": "family",        "en": "Thank you for having me",        "zh": "谢谢您的招待",       "py": "xiè xie nín de zhāo dài",         "phon": "shyeh shyeh neen duh jaow DYE" },
    { "id": "youve-worked-hard","cat": "family",        "en": "You've gone to so much trouble", "zh": "您辛苦了",           "py": "nín xīn kǔ le",                   "phon": "neen shin KOO luh",                   "note": "Says \"I see how much effort you put in.\" Lands beautifully with parents." },
    { "id": "let-me-help-out",  "cat": "family",        "en": "Let me help",                    "zh": "我来帮忙",           "py": "wǒ lái bāng máng",                "phon": "wor lye bahng MAHNG",                 "note": "Offer this at the table. They'll refuse. Offer anyway." },
    { "id": "so-delicious",     "cat": "family",        "en": "This is so delicious",           "zh": "太好吃了",           "py": "tài hǎo chī le",                  "phon": "tye how CHR luh" },
    { "id": "im-full-thanks",   "cat": "family",        "en": "I'm full, thank you",            "zh": "我吃饱了，谢谢",     "py": "wǒ chī bǎo le xiè xie",           "phon": "wor chr BAOW luh shyeh shyeh",        "note": "You will need this several times. They will keep feeding you." },
    { "id": "care-for-her",     "cat": "family",        "en": "I'll take good care of her",     "zh": "我会好好照顾她",     "py": "wǒ huì hǎo hǎo zhào gù tā",       "phon": "wor hway how how jaow goo TAH",       "note": "The big one. Say it to her parents and mean it." },
    { "id": "look-after-me",    "cat": "family",        "en": "Please look after me",           "zh": "请多关照",           "py": "qǐng duō guān zhào",              "phon": "ching dwor gwahn JAOW",               "note": "A humble set phrase for being the new person. Very well received." },
    { "id": "hello-grandma",    "cat": "family",        "en": "Hello, Grandma",                 "zh": "奶奶好",             "py": "nǎi nai hǎo",                     "phon": "nye nye HOW",                         "note": "奶奶 is dad's mum. Mum's mum is 外婆 — see below." },
