  "phrases": [
    { "id": "i-love-you",       "cat": "affection",     "en": "I love you",                     "zh": "我爱你",             "py": "wǒ ài nǐ",                        "phon": "wor EYE nee" , "starter": 1 },
    { "id": "love-you-so-much", "cat": "affection",     "en": "I love you so much",             "zh": "我好爱你",           "py": "wǒ hǎo ài nǐ",                    "phon": "wor how EYE nee",                     "note": "好 here means \"so\" — softer and more doting than 很." },
    { "id": "i-like-you",       "cat": "affection",     "en": "I'm crazy about you",            "zh": "我喜欢你",           "py": "wǒ xǐ huan nǐ",                   "phon": "wor SHEE hwahn nee" },
    { "id": "i-miss-you",       "cat": "affection",     "en": "I miss you",                     "zh": "我想你了",           "py": "wǒ xiǎng nǐ le",                  "phon": "wor SHYAHNG nee luh" , "starter": 2 },
