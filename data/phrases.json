    { "id": "happy-with-you",   "cat": "affection",     "en": "I'm so happy when I'm with you", "zh": "和你在一起我很开心", "py": "hé nǐ zài yì qǐ wǒ hěn kāi xīn",  "phon": "huh nee dzye yee chee wor hun kye SHIN" },
    { "id": "always-with-you",  "cat": "affection",     "en": "I want to be with you always",   "zh": "我想一直和你在一起", "py": "wǒ xiǎng yì zhí hé nǐ zài yì qǐ", "phon": "wor shyahng yee jr huh nee dzye yee CHEE" },
    { "id": "favorite-person",  "cat": "affection",     "en": "You're my favorite person",      "zh": "你是我最喜欢的人",   "py": "nǐ shì wǒ zuì xǐ huan de rén",    "phon": "nee shr wor dzway shee hwahn duh RUN" },
    { "id": "lucky-to-have-you","cat": "affection",     "en": "I'm lucky to have you",          "zh": "有你真好",           "py": "yǒu nǐ zhēn hǎo",                 "phon": "yoh nee jun HOW" },

    { "id": "youre-cute",       "cat": "compliments",   "en": "You're so cute",                 "zh": "你好可爱",           "py": "nǐ hǎo kě ài",                    "phon": "nee how kuh EYE",                     "note": "可爱 is the everyday \"cute\" — safe and sweet any time." , "starter": 3 },
